##################################
## SlaveSelection Down Settings ##
####################################################################################################
#                                                                                                  #
# Only used if you are using                                                                       #
# [org.drftpd.master.slaveselection.filter.SlaveSelectionManager] in "master.conf"                 #
#                                                                                                  #
# The slave that is selected will be an available slave and will have more                         #
# points (given from the filters) than the other available slaves.                                 #
#                                                                                                  #
# EXAMPLES:                                                                                       #
# Bandwidth (SlaveScore - (multiplier * current bw usage of slave)).                               #
# x.filter=bandwidth                                                                               #
# x.multiplier=5                                                                                   #
#                                                                                                  #
# Cycle (If there is a tie in SlaveScore's,                                                        #
#  Cycle adds one point to the last used slave(in the tie)).                                       #
# x.filter=cycle                                                                                   #
#                                                                                                  #
# MatchDir (Sets appropriate settings from "assign" on transfers inside "path").                   #
# x.filter=matchdir                                                                                #
# x.match=/section/*                                                                               #
# x.assign=slave1+500 slave2-500 slave3+remove                                                     #
# (name+N / name-N adds or subtracts score, name+remove / name-remove removes slave;               #
#  all+N / all-N applies to every slave, all+remove removes every slave;                           #
#  entries are applied in order; slave names may contain "-", e.g. slave-1-500)                    #
# x.assume.remove=false (if true removes all slaves not mentioned in assign).                      #
# x.negate.expression=false (if true negates the glob set in match).                               #
#                                                                                                  #
# MatchDirEx (Same as MatchDir but uses regular expression instead of globs).                      #
# x.filter=matchdirex                                                                              #
# x.match=^/section/.*$                                                                            #
# x.assign=slave1+500 slave2-500 slave3+remove                                                     #
# (name+N / name-N adds or subtracts score, name+remove / name-remove removes slave;               #
#  all+N / all-N applies to every slave, all+remove removes every slave;                           #
#  entries are applied in order; slave names may contain "-", e.g. slave-1-500)                    #
# x.assume.remove=false (if true removes all slaves not mentioned in assign).                      #
# x.negate.expression=false (if true negates the glob set in match).                               #
#                                                                                                  #
# MaxtransfersPerslave (This will allow 10 transfers on slave1 and 5 on slave2).                   #
# x.filter=MaxtransfersPerslave                                                                    #
# x.assign=slave1+10 slave2+5                                                                      #
# x.match=^/section/.*$                                                                            #
# x.negate.expression=false                                                                        #
#                                                                                                  #
#                                                                                                  #
# MonthlyTraffic (per-slave monthly traffic quota with a soft and a hard limit, opt-in).           #
# x.filter=monthlytraffic                                                                          #
# x.limit=500GB (default hard limit, optional). At or over it the slave is removed.                #
# x.limit.slave1=2TB (hard limit for one slave, overrides the default, optional).                  #
# x.warn=80% (soft limit: percent of the limit or bytes like 400GB, optional).                     #
# Between warn and limit the score is lowered by (used - warn) * multiplier.                       #
# x.direction=both (up, down or both: which month counters count towards the quota).               #
# x.multiplier=1 (soft part only, "remove" removes the slave from warn on).                        #
# Slaves without a limit are not touched. The sitebot announces warn/limit                         #
# (announce type "slavequota"). Counters are the slave month stats.                                #
# At the hard limit the slave is removed from every chain using this filter, downloads included,   #
# so a file held only by that slave cannot be downloaded until the next month.                     #
# In practice the warn-zone penalty acts like removal: it is the raw bytes over warn times the     #
# multiplier, which outweighs every other filter.                                                  #
# The usage levels are kept in memory, so the warn/limit announces repeat after a master restart.  #
####################################################################################################

## Default Config (suggested for ultimate bandwidth usage).
1.filter=bandwidth
1.multiplier=1

2.filter=cycle

