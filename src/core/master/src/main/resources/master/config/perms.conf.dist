####################
## Perms Settings ##
###################################################################################################

# Displayed as the site tagline on first connection.
# Leave it alone and you will see the version following by link.
login_prompt DrFTPD 4.0.12-git https://github.com/drftpd-ng/drftpd

###################################################################################################
#                                                                                                 #
# Max number of connections.                                                                      #
#                                                                                                 #
# EXAMPLES:                                                                                       #
#  max_users      <max_logins>   <max_exempted>                                                   #
#  max_users      100   10                                                                        #
#  exempt         =siteop                                                                         #
#                                                                                                 #
# Above would allow normal users to connect until there are 100 concurrent users.                 #
# siteop's would be able to connect until there are 110 concurrent users.                         #
#                                                                                                 #
###################################################################################################

max_users      100   10
exempt         =siteop

####################################################################################################
#                                                                                                  #
# FUNCTION | PATH | GROUP                                                                          #
# * = only wildcard recognized                                                                     #
# = denotes group, - denotes user                                                                  #
#                                                                                                  #
# EXAMPLES:                                                                                        #
# upload        *   =siteop                                                                        #
# download      *   -user1                                                                         #
# makedir       /usercanmakedir/*   -user1 -user2 =group1                                          #
#                                                                                                  #
####################################################################################################

upload         *   *
download       *   *

makedir        *   *

deleteown      *   *
delete         *   =siteop

renameown      *   *
rename         *   =siteop

# Where SITE WIPE (and SITE FIND -wipe) may be used. Who may use the
#  command at all is set in the commands config ("site wipe" perms).
# The first matching line wins. If no wipe line matches a path, wiping is
#  allowed (the delete/deleteown permissions above still apply).
# A recursive wipe of a directory is refused as a whole if any file or directory
#  below it is denied by a wipe line (hidden paths included).
# These rules only apply to SITE WIPE and SITE FIND -wipe. They do not apply to
#  system deletes that bypass the permission checks (deleteUnchecked), such as
#  AutoFreeSpace, REQDELETE and similar plugins.
# Note: '*' also matches '/' and directories are matched with a trailing '/',
#  so put the more specific lines first.
# Example: allow wiping releases inside /archive/<section>/, but not
#  /archive itself or the section dirs:
#wipe           /archive/*/?*   =siteop =wipe
#wipe           /archive/*      !*
#wipe           *               =siteop =wipe

privpath       /hidden_path/   =siteop

# Home directories (see 'homedir' in master.conf).
# A home directory only sets where a user lands after login, it does NOT grant
#  any permission: restrict it here like any other path.
# The first matching line wins, so these lines must come BEFORE the wildcard
#  rules above (e.g. 'upload * *' and 'makedir * *').
# Example giving user1 a private home directory in /home/user1
#  (directory paths are matched with a trailing '/', so '/home/user1/*' also matches
#  /home/user1 itself):
#privpath       /home/user1/     -user1 =siteop
#upload         /home/user1/*    -user1
#makedir        /home/user1/*    -user1
#upload         /home/*          =siteop
#makedir        /home/*          =siteop

# Hide the user that's is inside the given dir.
hideinwho      /hidden_path/*   *

# Appends the message contained in the file to the
#  text that is outputed during CWD.
# Create the necessary file(s) into "config/themes/text".
#msgpath      <path>   <filename>   <flag/=group/-user>
#msgpath      /incoming/   incoming.txt

# Choose who can connect and who can't.
# allow_connections      * => everyone can connect.
# allow_connections      =siteop => only users from the siteop group can connect.
# Default: [*]
allow_connections        *
#allow_connections_deny_reason Access Denied

# Accepts only one range of ports.
#pasv_ports 50000-60000

# To be used if your master does not report the correct outside ip for
#  PASV commands.
#pasv_addr xxx.xxx.xxx.xxx

# If you have (an) ftp bouncer(s), you have to put their IP(s) here so that drftpd
#  knows if the connection is from a bouncer or a regular user.
# Either in IPv4 address or hostname format.
#bouncer_ips 1.2.3.4 another.bouncer.dynamicip.net static.bouncer.com

# SSL/TLS enforcements.
# Default: Allow only encrypted
userrejectsecure        !*
userrejectinsecure      *
denydiruncrypted        *
denydatauncrypted       *

# Hide IP's in logs?
# Default: [true]
hide_ips true

# Hide users or group from shown in stats outputs
hideinstats      =deleted =exempt

# Don't update files and bytes on transfers.
#nostatsup      /pre/*   *
#nostatsdn      /pre/*   *

# Control credit ratio on uploads (0 = no credits).
#creditcheck      <path>   <ratio>   <=group/-user>

# Control credit ratio on downloads (0 = no credits).
# Users with ratio 0 (leech) are never charged for downloads, whatever the creditloss lines say.
#creditloss      <path>   <ratio>   <=group/-user>

# Limit UL/DL over time.
# Direction : UP/DN
# Period : ALL/DAY/WEEK/MONTH
#creditlimit <path> <direction> <period> <bytes> <=group/-user>

# Allows pre in /pre/* to group siteop.
pre	/pre/* =siteop

####################################################################################################
#                                                                                                  #
# This is to deny Download's of files currently being uploaded.                                    #
#                                                                                                  #
# EXAMPLES:                                                                                        #
# denydownload /PATH* =group -user                                                                 #
# denydownload /PATH* *                                                                            #
#                                                                                                  #
####################################################################################################

####################################################################################################
#                                                                                                  #
# Release completeness rules (zipscript plugin). Both are OFF unless you add a line.              #
#                                                                                                  #
# downloadinc    /PATH* <who is exempt>                                                            #
#   Denies downloading (RETR) any file of a release that is NOT complete yet (anti-leech of races).#
#                                                                                                  #
# deletecomplete /PATH* <who is exempt>                                                            #
#   Denies DELE and SITE WIPE of any file or directory INSIDE a release that is complete.          #
#   (The release directory itself can still be wiped, only what is inside it is protected.)        #
#                                                                                                  #
# How it works:                                                                                    #
#  - The first line whose path matches the directory holding the file wins. If no line matches,    #
#    nothing changes. The users/groups on the line are the EXEMPT ones: they may still            #
#    download/delete. Use !* for "nobody is exempt".                                               #
#  - The release is the directory holding the .sfv. A release with only .zip files uses the zip    #
#    DIZ file total. A file in a subdirectory without its own sfv (CD1, Sample...) belongs to the  #
#    nearest parent directory (up to 2 levels up) holding an .sfv or .zip files.                   #
#  - Complete = every file listed in the sfv (or the DIZ total) is present. If the state cannot    #
#    be determined (no sfv, slave offline, unreadable sfv) the command is ALLOWED.                 #
#  - They are checked on RETR, DELE and SITE WIPE only. Plugins that delete without permission     #
#    checks (AutoFreeSpace, REQDELETE, SITE FIND -wipe...) are not affected.                       #
#                                                                                                  #
# EXAMPLES:                                                                                        #
# downloadinc    /MP3/* =siteop -uploader                                                          #
# deletecomplete /MP3/* =siteop                                                                    #
# deletecomplete /ARCHIVE/* !*                                                                     #
#                                                                                                  #
####################################################################################################

# The below directives allow you to manage
#  who can FXP *from* and *to* this FTP.
#deny_upfxp /PATH* =group -user
#deny_dnfxp /PATH* *

####################################################################################################
#                                                                                                  #
# This is to DupeCheck of files/directory's currently being uploaded.                              #
#                                                                                                  #
# DupeCheck Options located in "dupecheck.conf"                                                    #
#                                                                                                  #
# EXAMPLES:                                                                                        #
# dupecheck /PATH* =group -user                                                                    #
# dupecheck /PATH* *                                                                               #
#                                                                                                  #
####################################################################################################

####################################################################################################
#                                                                                                  #
# These are Regex Implementations of user permissions on the site.                                 #
#                                                                                                  #
# makedirex   - Create Directory Permission                                                        #
# uploadex    - Upload Permission                                                                  #
# downloadex  - Download Permission                                                                #
# deleteex    - Delete Permission                                                                  #
# deleteownex - Delete Own Permission                                                              #
# renameex    - Rename Permission                                                                  #
# renameownex - Rename Own Permission                                                              #
# privpathex  - Private Path Permission                                                            #
# wipeex      - Wipe Permission                                                                    #
#                                                                                                  #
# EXAMPLES:                                                                                        #
# makedirex      ^/SECTION1/.*(sectionkeyword1|sectionkeyword2).*$   !*                            #
# uploadex       ^.*(sitekeyword1|sitekeyword2).*$   !*                                            #
# wipeex         ^/[^/]+$   !*    (nobody can wipe anything directly in the root dir)              #
#                                                                                                  #
####################################################################################################

# Allow only ASCII characters on MKD/STOR/RNTO.
makedirex [^\p{ASCII}] !*
uploadex [^\p{ASCII}] !*
renameex [^\p{ASCII}] !*
renameownex [^\p{ASCII}] !*

