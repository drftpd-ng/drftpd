################################
## SlaveSelection Up Settings ##
####################################################################################################
#                                                                                                  #
# Only used if you are using                                                                       #
# [org.drftpd.master.slaveselection.filter.SlaveSelectionManager] in "master.conf"                 #
#                                                                                                  #
# The slave that is selected will be an available slave and will have more                         #
# points(given from the filters) than the other available slaves.                                  #
#                                                                                                  #
# EXAMPLES:                                                                                        #
# Bandwidth (SlaveScore - (multiplier * current bw usage of slave)).                               #
# .filter=bandwidth                                                                                #
# .multiplier=5                                                                                    #
#                                                                                                  #
# Cycle (If there is a tie in SlaveScore's,                                                        #
#  Cycle adds one point to the last used slave(in the tie)).                                       #
# .filter=cycle                                                                                    #
#                                                                                                  #
# MatchDir (Sets appropriate settings from "assign" on transfers inside "path").                   #
# .filter=matchdir                                                                                 #
# .match=/section/*                                                                                #
# .assign=slave1+500 slave2-500 slave3+remove                                                      #
# (name+N / name-N adds or subtracts score, name+remove / name-remove removes slave;               #
#  all+N / all-N applies to every slave, all+remove removes every slave;                           #
#  entries are applied in order; slave names may contain "-", e.g. slave-1-500)                    #
# .assume.remove=false (if true removes all slaves not mentioned in assign).                       #
# .negate.expression=false (if true negates the glob set in match).                                #
#                                                                                                  #
# MatchDirEx (Same as MatchDir but uses regular expression instead of globs).                      #
# .filter=matchdirex                                                                               #
# .match=^/section/.*$                                                                             #
# .assign=slave1+500 slave2-500 slave3+remove                                                      #
# (name+N / name-N adds or subtracts score, name+remove / name-remove removes slave;               #
#  all+N / all-N applies to every slave, all+remove removes every slave;                           #
#  entries are applied in order; slave names may contain "-", e.g. slave-1-500)                    #
# .assume.remove=false (if true removes all slaves not mentioned in assign).                       #
# .negate.expression=false (if true negates the glob set in match).                                #
#                                                                                                  #
# MaxtransfersPerslave (This will allow 10 transfers on slave1 and 5 on slave2)                    #
# .filter=MaxtransfersPerslave                                                                     #
# .assign=slave1+10 slave2+5                                                                       #
# .match=^/section/.*$                                                                             #
# .negate.expression=false                                                                         #
#                                                                                                  #
#                                                                                                  #
# MonthlyTraffic (per-slave monthly traffic quota with a soft and a hard limit, opt-in).           #
# .filter=monthlytraffic                                                                           #
# .limit=500GB (default hard limit, optional). At or over it the slave is removed.                 #
# .limit.slave1=2TB (hard limit for one slave, overrides the default, optional).                   #
# .warn=80% (soft limit: percent of the limit or bytes like 400GB, optional).                      #
# Between warn and limit the score is lowered by (used - warn) * multiplier.                       #
# .direction=both (up, down or both: which month counters count towards the quota).                #
# .multiplier=1 (soft part only, "remove" removes the slave from warn on).                         #
# Slaves without a limit are not touched. The sitebot announces warn/limit                         #
# (announce type "slavequota"). Counters are the slave month stats.                                #
####################################################################################################

## Default Config (suggested for ultimate bandwidth usage).
1.filter=bandwidth
1.multiplier=1

2.filter=minfreespace
2.multiplier=1
2.minfreespace=1GB

3.filter=minfreespace
3.minfreespace=100MB
3.multiplier=0

4.filter=cycle

