########################
## ZIPScript Settings ##
####################################################################################################

# Show status bar in dir listings
# Default: [true]
statusbar.enabled=true

# Type of status bar, if true then status bar will appear as a directory,
#  if false it will appear as a file.
# Default: [true]
statusbar.directory=true

# Showing missing files
# Default: [true]
files.missing.enabled=true

# Set the following line to enable/disable id3tag info.
# Default: [true]
cwd.id3info.enabled=true

# Enable race stats.
# Default: [true]
cwd.racestats.enabled=true
stor.racestats.enabled=true

# Only allow files found in the sfv file.
# Default: [true]
sfv.restrict.files=true

# Set the following line to enable/disable file_id.diz info.
# Default: [true]
cwd.dizinfo.enabled=true

# When an sfv is uploaded after some of its files, check those files against it
# (using the checksum from their upload) and delete the ones that don't match,
# the same as for files uploaded after the sfv.
# Note: uploading a wrong sfv will delete the already uploaded files it doesn't match.
# Default: [true]
sfv.check.existing=true

# Disallow files before sfv.
# Default: [true]
sfvfirst.required=true

# Allow files w/o extensions even if "sfvfirst.required=true".
# Default: [true]
sfvfirst.allownoext=true

# Allow these file extensions even if not in an sfv file.
allowedexts=nfo txt jpg diz avi vob m2ts mkv mp4 zip m3u

# Check paths for sfv first enforcement.
# Default: [*]
sfvfirst.pathcheck=*

# Ignore paths for sfv first enforcement.
sfvfirst.pathignore=/PRE/* /REQUESTS/* */Subs/ */Cover/ */Covers/ /SPEEDTEST/*

# Who has their restricted by the sfv-first system?
# If you wanted siteop group to be exempt, put: !=siteop *
sfvfirst.users=*

# Disallows .sfv to be uploaded if subdir of (sfvdeny.subdir.include) exists.
# Default: [false]
sfvdeny.subdir=false

# List of the subdirs to include when searching to deny sfv upload (regex).
sfvdeny.subdir.include=.*(?i)(cd[1-9]|dvd[1-9]|dis(c|k)[1-9]).*

# List of sections/dirs to exclude when searching for deny sfv upload (regex).
sfvdeny.subdir.exclude=.*(?i)(SPEEDTEST|REQUESTS|STAFF|PRE).*

# Check integrity of .zip files on upload.
# Default: [true]
stor.zip.integrity.check.enabled=true

# Show diz text on CWD.
# Default: [true]
cwd.diz.info.enabled=true

# Enable race stats.
# Default: [true][true]
cwd.zip.racestats.enabled=true
stor.zip.racestats.enabled=true

# Maximum number of users/groups to include in race complete announce.
# Default [10][10]
irc.sfv.maxusers=10
irc.sfv.maxgroups=10

# Enable MP3 info.
# Default: [true][true]
cwd.mp3info.enabled=true
stor.mp3info.enabled=true

# Maximum number of users/groups to include in race complete announce.
# Default: [10][10]
irc.zip.maxusers=10
irc.zip.maxgroups=10

# Enable Flac info
# Default: [true][true]
cwd.flacinfo.enabled=true
stor.flacinfo.enabled=true


# Per-release-type announce themes (opt-in).
# When true, the sfv.* and zip.* announce keys in the irc theme are first looked up with a
#  release type suffix and fall back to the plain key when no such key exists, e.g.
#  sfv.store.complete.mp3.vbr -> sfv.store.complete.mp3 -> sfv.store.complete.audio -> sfv.store.complete
# Types: mp3.cbr, mp3.vbr, mp3, flac, audio, rar, video, zip
#  (the type is taken from the file that was just uploaded; mp3.cbr/mp3.vbr come from the MP3 info)
# With no suffixed keys in the theme, output is identical to leaving this off.
# Default: [false]
irc.themes.bytype=false

# UPDATE announce during long races (opt-in, off by default).
# An UPDATE line (announce type store.update, theme key sfv.store.update / zip.store.update) is
#  announced when a release gets another N files (irc.update.files) and/or another N percent
#  (irc.update.percent) closer to completion since the last UPDATE, but never more often than once
#  per irc.update.interval seconds per release. Set a value to 0 to disable that trigger; with
#  both at 0 no UPDATE is ever announced. The first file (FIRST) and the last (COMPLETE) are
#  not announced as UPDATE.
# Like other announce types it can be routed in irc.announce.conf (store.update.path.N / .section.N),
#  otherwise it goes to the default channels.
# Default: [0][0][60]
irc.update.files=0
irc.update.percent=0
irc.update.interval=60

# Hide user and group names in race output: the race, halfway, complete and
# new race leader announces on IRC and the race stats shown on CWD and STOR.
# Default: [false] (names are shown as they are)
hideuser.enabled=false

# Members of these groups are shown as the placeholder instead of their name,
# and the groups themselves are shown as the group placeholder in the group stats.
# Only the user's primary group is matched, not secondary groups.
# Space or comma separated, not case sensitive.
hideuser.groups=

# These users are shown as the placeholder instead of their name (and so is the
# group shown next to them).
hideuser.users=

# Only hide names for releases in these sections (section names, space or comma
# separated). Leave empty to hide them in every section.
hideuser.sections=

# What a hidden user is shown as, and a hidden group (empty: same as the user placeholder).
# Default: [Anonymous]
hideuser.placeholder=Anonymous
hideuser.group.placeholder=
