#############################
## Auto FreeSpace Settings ##
####################################################################################################

# Smallest number of time in between cycles.
# Times are represented in minutes.
#
# 1440 = 1 day
# 10080 = 1 week
# 43200 = 1 month
#
# Default: [1440]
cycleTime=1440

# Do not delete files with this following names (regex).
#excluded.file.1=.*speedtest.*

# Exclude these slaves from autowipe (space separated).
#excluded.slaves=SLAVE1

# Only announce, no delete.
# Default: [true]
announce.only=true

# Max iterations for any single mode run per slave per cycle
# Default: [5]
max.iterations=5

# On which mode should autofreespace work.
# Possible options: disabled, date, space
# disabled: Do nothing (plugin disabled)
# date: Delete files based on wipeAfter per section
# space: Delete files based on keepFree
# Default: [disabled]
mode=disabled

# AutoFreeSpace will try to keep each slave above this number (Only used if mode = space).
# Default: [100GB]
keepFree=100GB

# Space mode only: when no X.section/X.path entry is written below, delete from every section.
# WARNING: this includes PRE, REQUESTS, group folders and any other section, not only release sections.
# It is ignored as soon as one entry is written, even an invalid one (e.g. a mistyped section name).
# When false and no entry is written, space mode deletes nothing.
# Default: [false]
wipe.all.sections=false

# Which releases to consider, one entry per number (1, 2, 3...).
# Each entry uses either X.section=<section name> or X.path=<VFS path>.
# A path can use * to match every subdirectory at that level, e.g. /MP3/* for dated MP3 directories.
# X.wipeAfter: do not delete releases younger than X minutes.
# wipeAfter is required in date mode: an entry without a valid wipeAfter is skipped.
#1.section=SECTION1
#1.wipeAfter=43200
#2.path=/MP3/*
#2.wipeAfter=43200

